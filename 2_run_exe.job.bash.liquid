#!/bin/bash -l
#SBATCH -N 1
#SBATCH --ntasks={% value_of mpi_size %}
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Load modules
echo "Loading modules"
module load hdf5
module load cmake

## Get the executable input from MEE and add execute privileges
{% stage_in_artifact hemoFlow %}
chmod +x $SCRATCHDIR/hemoFlow

## Running simulation
echo "Running simulation for patient {{ case_number }}"
mpirun -n {% value_of mpi_size %} $SCRATCHDIR/hemoFlow {% value_of cohort_path %}/{{ case_number }}/*.xml

echo "Finished"
