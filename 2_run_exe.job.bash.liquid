#!/bin/bash -l
#SBATCH -N 1
#SBATCH --ntasks={% value_of mpi_size %}
#SBATCH --cpus-per-task=1
#SBATCH --time={% value_of timelimit %}
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Load modules
echo "Loading modules"
module load hdf5
module load cmake

## Get the executable input from MEE and add execute privileges
{% stage_in_artifact hemoFlow %}
chmod +x $SCRATCHDIR/hemoFlow

patient_name={{ case_number }}
case_id=$(echo "$patient_name" | grep -oP "NAP\d+")
case_full_id=$(echo "$patient_name" | grep -oP "NAP\d+_ane_[^_]+_[^_]+")

{% stage_in_by_filename "${patient_name}.xml" %}
{% stage_in_by_filename "cerebral_flowrate_hypertensive.txt" %}
{% stage_in_by_filename "${case_id}_0_aneurysmSack.vtp" %}
{% stage_in_by_filename "${case_id}_0_interpolatedcl.vtp" %}
{% stage_in_by_filename "${case_id}_0_patchcl.vtp" %}
{% stage_in_by_filename "${case_id}_GlobalShift.csv" %}
{% stage_in_by_filename "${case_id}_LocalShift.csv" %}
{% stage_in_by_filename "${case_id}_Rot1.csv" %}
{% stage_in_by_filename "${case_id}_Rot2.csv" %}
{% stage_in_by_filename "vox_${case_full_id}_20M_c.npz" %}

CASE_DIR=/net/pr2/projects/plgrid/plggisw/VirtualFD/campaigns/{{ campaign_name }}/{{ case_number }}
mkdir -p $CASE_DIR
cd $SCRATCHDIR
mv *.xml $CASE_DIR
mv *.txt $CASE_DIR
mv *.vtp $CASE_DIR
mv *.npz $CASE_DIR
mv "${case_id}_GlobalShift.csv" "${CASE_DIR}/GlobalShift.csv"
mv "${case_id}_LocalShift.csv" "${CASE_DIR}/LocalShift.csv"
mv "${case_id}_Rot1.csv" "${CASE_DIR}/Rot1.csv"
mv "${case_id}_Rot2.csv" "${CASE_DIR}/Rot2.csv"

## Running simulation
echo "Running simulation for patient ${patient_name}"
mpirun -n {% value_of mpi_size %} ./hemoFlow "${CASE_DIR}/${patient_name}.xml"

echo "Finished"
