#!/bin/bash -l
#SBATCH -N 1
#SBATCH --ntasks=4
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo Preparing computation source code
{% clone_repo SanoISW/virtualfd.git %}

## Load modules
echo Loading modules
module load hdf5/1.10.8-gompi-2021b
ln -s  $EBROOTOPENMPI/lib64/libmpi.so.40 libmpi.so.20
ln -s $EBROOTHDF5/lib/libhdf5.so.103 libhdf5.so.9
export LD_LIBRARY_PATH=$PWD:$LD_LIBRARY_PATH

## Running simulation
echo Running simulation
mpirun -n 4 /net/pr2/projects/plgrid/plggisw/VirtualFD/hemoFlow_rhel6c6 {% value_of datafile %}

DIR="$(dirname {% value_of datafile %})"
echo staging output from:
echo "${DIR}/output"
cd $DIR
cd output

for result_file in *.vti
do
    if [ -f "$result_file" ]
    then
        {% stage_out "$result_file" %}
    else
        continue
    fi
done
echo Finish
