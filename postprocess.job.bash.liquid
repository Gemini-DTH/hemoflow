#!/bin/bash -l
#SBATCH -N 1
#SBATCH --mem=32GB
#SBATCH --cpus-per-task=1
#SBATCH --time=00:30:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo "Preparing computation source code"
{% clone_repo %}
cd virtualfd

## Load modules
echo Loading modules
module load python

## Postprocessing
source activate $PLG_GROUPS_STORAGE/plggisw/VirtualFD/vfd_venv

## Get the case directory path
datafile={% value_of datafile %}
DIR="$(dirname "${datafile}")"

## Merge results
python3 main_average.py "${DIR}/output" avglocal -p

## Save results
cd "${DIR}/postProc"
{% stage_out *.vti %}

echo Finish