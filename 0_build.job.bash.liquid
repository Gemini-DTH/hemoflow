#!/bin/bash -l
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=00:30:00
#SBATCH --mem=8G
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid-testing
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo Preparing computation source code
{% clone_repo SanoISW/virtualfd.git %}

cd virtualfd
cd hemoflow

## Load modules
echo Loading modules
module load hdf5
module load cmake

## Building with cmake
echo Building
mkdir build
cd build
cmake ..
make -j 8

echo Executable generated in:
pwd

{% stage_out hemoFlow %}

echo Finish
