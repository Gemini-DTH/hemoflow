#!/bin/bash -l
#SBATCH -N 1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH --mem=20GB
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH -C memfs
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Load modules
echo "Loading modules"
module load python
module load miniconda3

## Set up an environment
echo "Setting up conda environment"
cd $MEMFS
mkdir lbmpost_mountpoint
squashfuse /net/pr2/projects/plgrid/plggisw/VirtualFD/lbmpost.squashfs lbmpost_mountpoint

## Get LBMpost
#TODO Change this to cloning LBMPost when repo is ready and public
cp /net/pr2/projects/plgrid/plggisw/VirtualFD/LBMpost-dev.zip .
unzip LBMpost-dev.zip
cd LBMpost-dev

## Running postprocessing
conda activate $MEMFS/lbmpost_mountpoint
CAMPAIGN_DIR=$SCRATCH/VirtualFD_Campaigns/{{ campaign_name }}
CASE_DIR=$CAMPAIGN_DIR/{{ case_number }}
PURGE={% value_of purge %}

echo "Running postprocessing for ${CASE_DIR}/output..."
if [ "$PURGE" == "True" ]; then
    python main.py $CASE_DIR {% value_of mode %} -p
else
    python main.py $CASE_DIR {% value_of mode %}
fi

## Save results
echo "Staging out output from:"
echo "${CASE_DIR}/postProc"
cd $CASE_DIR/postProc

{% stage_out *.csv %}

echo "Postprocessing finished"
