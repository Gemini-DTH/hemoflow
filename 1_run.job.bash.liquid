#!/bin/bash -l
#SBATCH -N 2
#SBATCH --ntasks-per-node=2
#SBATCH --time=00:30:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid-testing
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo Preparing computation source code
{% clone_repo SanoISW/virtualfd.git %}

## Load modules
echo Loading modules

module load plgrid/libs/hdf5/1.8.16
module load plgrid/tools/impi

## Running simulation
cd $SCRATCH/virtualfd/hemoflowcfd/build
mpirun -n 4 ./hemoFlow {% value_of datafile %}

echo Finish
