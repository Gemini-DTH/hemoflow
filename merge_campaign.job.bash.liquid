#!/bin/bash -l
#SBATCH -N 1
#SBATCH --mem=4GB
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo "Preparing computation source code"
{% clone_repo %}
cd virtualfd

## Load modules
echo Loading modules
module load python
module load miniconda3

## Setting env
ENV_PATH=$SCRATCH/lbmpost
ENV_LOCKFILE="$SCRATCH/lbmpost.lock"

if [ ! -d "$ENV_PATH" ]; then
    echo "LBMPost environment not found."

    while [ -e "$ENV_LOCKFILE" ]; do
        echo "Env already being set up. Waiting..."
        sleep 30
    done

    ## Create lockfile
    if ( set -o noclobber; echo "$$" > "$ENV_LOCKFILE" ) 2> /dev/null; then
        trap 'rm -f "$ENV_LOCKFILE"; exit $?' INT TERM EXIT

        ## Create conda env
        echo "Creating LBMPost env..."
        cp /net/pr2/projects/plgrid/plggisw/VirtualFD/LBMpost-main.zip .
        unzip LBMpost-main.zip
        cd LBMpost-main
        conda config --set auto_activate_base false
        mkdir -p $SCRATCH/.conda
        conda config --add pkgs_dirs $SCRATCH/.conda
        conda env create --prefix $SCRATCH/lbmpost --file environment.yml

        ## Remove lockfile
        rm -f "$ENV_LOCKFILE"
        trap - INT TERM EXIT
    else
        exit 1
    fi
else
    echo "LBMPost conda env already exists. Skipping setup."
fi

cd

## Get the campaign name
campaign_name={% value_of campaign_name %}

## Merge campaign results
conda activate $ENV_PATH
cd $TMPDIR/virtualfd
RESULTS_DIR=/net/pr2/projects/plgrid/plggisw/VirtualFD/campaigns/$campaign_name
python simDataCollector.py $RESULTS_DIR

## Save results
cd $RESULTS_DIR
mv simulationData.csv "${campaign_name}_results.csv"

{% stage_out "${campaign_name}_results.csv" %}

echo Finish