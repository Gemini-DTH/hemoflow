#!/bin/bash -l
#SBATCH -N 1
#SBATCH --mem=4GB
#SBATCH --cpus-per-task=1
#SBATCH --time=01:00:00
#SBATCH -A {{ grant_id }}
#SBATCH -p plgrid
#SBATCH --output ./slurm-%j.out
#SBATCH --error ./slurm-%j.err

# Finish with error on first command with error
set -e

cd $TMPDIR
pwd

## Clone repository and switch into selected revision
echo "Preparing computation source code"
{% clone_repo %}
cd virtualfd

## Load modules
echo "Loading modules"
module load python
module load miniconda3

## Set up an environment
echo "Setting up conda environment"
cd $MEMFS
mkdir lbmpost_mountpoint
squashfuse /net/pr2/projects/plgrid/plggisw/VirtualFD/lbmpost.squashfs lbmpost_mountpoint

## Get LBMpost
#TODO Change this to cloning LBMPost when repo is ready and public
cp /net/pr2/projects/plgrid/plggisw/VirtualFD/LBMpost-dev.zip .
unzip LBMpost-dev.zip
cd LBMpost-dev

## Get the campaign name
campaign_name={% value_of campaign_name %}

## Merge campaign results
conda activate $MEMFS/lbmpost_mountpoint
cd $TMPDIR/virtualfd
RESULTS_DIR=$SCRATCH/VirtualFD_Campaigns/$campaign_name
python simDataCollector.py $RESULTS_DIR

## Save results
cd $RESULTS_DIR
mv simulationData.csv "${campaign_name}_results.csv"

{% stage_out "${campaign_name}_results.csv" %}

echo Finish